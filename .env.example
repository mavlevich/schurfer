# Copy this file to .env and fill in the values.
# Never commit .env to git.

# PostgreSQL
DATABASE_URL=postgresql://schurfer:schurfer_dev@localhost:5432/schurfer

# Redis
REDIS_ADDR=localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# API Gateway
PORT=8000
ENV=development

# Admin password hash — generate with:
#   go run ./apps/api-gateway/cmd/hash-password your_password
ADMIN_PASSWORD_HASH=

# JWT secret — generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Collector
# Leave empty to subscribe to all active USDT linear perps (recommended)
BYBIT_SYMBOLS=

# Analytics / pump scanner
PUMP_MIN_PCT=30
SCAN_INTERVAL=60
# Leave empty to use all supported exchanges
PUMP_EXCHANGES=

# Telegram alerts (notifier service)
# Get token from @BotFather, chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Execution — exchange API keys (only exchanges with both key+secret are activated)
# MEXC: Access Key → MEXC_API_KEY, Secret Key → MEXC_API_SECRET
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# Execution — testnet mode
# Set to true to route all exchanges to sandbox/testnet endpoints.
# When enabled, populate exchange key vars with testnet API keys.
TESTNET=false

# Execution — risk parameters
MAX_POSITIONS=5
MAX_POSITION_USD=500
DAILY_LOSS_LIMIT_USD=200
SCORE_THRESHOLD=6
LIQUIDATION_BUFFER_PCT=20
MIN_FUNDING_RATE_PCT=-0.1
REQUIRE_FUNDING_RATE=false
RISK_PER_TRADE_PCT=0

# Execution — exit strategy (dynamic, derived from pump magnitude — no manual config needed)

# Execution — signal trader (auto-shorting on pump signals)
# Set AUTO_TRADE=true to enable real orders. Set DRY_RUN=true for paper trading (mutually exclusive).
# DRY_RUN uses public exchange clients — no API keys needed for price feeds.
AUTO_TRADE=false
DRY_RUN=false
SIGNAL_POSITION_USD=50
SIGNAL_LEVERAGE=3
