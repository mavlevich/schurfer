# Copy this file to .env and fill in the values.
# Never commit .env to git.

# PostgreSQL
DATABASE_URL=postgresql://schurfer:schurfer_dev@localhost:5432/schurfer

# Redis
REDIS_ADDR=localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# API Gateway
PORT=8000
ENV=development

# Admin password hash — generate with:
#   go run ./apps/api-gateway/cmd/hash-password your_password
ADMIN_PASSWORD_HASH=

# JWT secret — generate with:
#   openssl rand -hex 32
JWT_SECRET=
