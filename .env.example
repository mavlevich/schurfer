# Copy this file to .env and fill in the values.
# Never commit .env to git.

# PostgreSQL
DATABASE_URL=postgresql://schurfer:schurfer_dev@localhost:5432/schurfer

# Redis
REDIS_ADDR=localhost:6379

# NATS
NATS_URL=nats://localhost:4222

# API Gateway
PORT=8000
ENV=development

# Admin password hash — generate with:
#   go run ./apps/api-gateway/cmd/hash-password your_password
ADMIN_PASSWORD_HASH=

# JWT secret — generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Collector
# Leave empty to subscribe to all active USDT linear perps (recommended)
BYBIT_SYMBOLS=
# Bounded Bybit hot-set consumer. Whole-venue tickers stay in memory; only active
# symbols receive retained five-second Redis bars.
HOTSET_BUCKET_SECONDS=5
HOTSET_PREBUFFER_SECONDS=600
HOTSET_TTL_SECONDS=14400
HOTSET_MAX_SYMBOLS=12
HOTSET_STREAM_MAXLEN=3600
HOTSET_STREAM_TTL_SECONDS=86400

# Analytics / pump scanner
PUMP_MEASUREMENT_MIN_PCT=20
PUMP_ENTRY_MIN_PCT=30
SCAN_INTERVAL=60
# Forward-only Gate source-lead measurement. This records quotes only; it never
# opens trades, and base-symbol identity remains provisional.
SOURCE_LEAD_CAPTURE_ENABLED=true
SOURCE_LEAD_TARGET_EXCHANGES=binance,bybit
SOURCE_LEAD_NOTIONAL_USD=50
SOURCE_LEAD_TIMEOUT_SECONDS=5
SOURCE_LEAD_BATCH_SIZE=8
SOURCE_LEAD_QUEUE_SIZE=16
SOURCE_LEAD_SHUTDOWN_TIMEOUT_SECONDS=10
# Forward-outcome worker (seconds / rows per DB polling batch)
OUTCOME_POLL_INTERVAL=300
OUTCOME_RETRY_AFTER=900
OUTCOME_BATCH_SIZE=50
OUTCOME_MAX_ATTEMPTS=8
DERIVATIVES_CONTEXT_ENABLED=true
DERIVATIVES_CONTEXT_SINCE=2026-07-27T00:00:00Z
DERIVATIVES_CONTEXT_BEFORE_MINUTES=240
DERIVATIVES_CONTEXT_AFTER_MINUTES=480
DERIVATIVES_CONTEXT_FETCH_LIMIT=200
DERIVATIVES_CONTEXT_MAX_PAGES=10
DERIVATIVES_CONTEXT_TIMEOUT=15
DERIVATIVES_CONTEXT_RETRY_AFTER=900
DERIVATIVES_CONTEXT_BATCH_SIZE=8
DERIVATIVES_CONTEXT_MAX_ATTEMPTS=8
# Funding-only history around closed episodes for 24h/72h/7d research.
LONG_HORIZON_FUNDING_ENABLED=true
LONG_HORIZON_FUNDING_SINCE=2026-07-22T00:00:00Z
LONG_HORIZON_FUNDING_BEFORE_MINUTES=1440
LONG_HORIZON_FUNDING_AFTER_MINUTES=10080
LONG_HORIZON_FUNDING_FETCH_LIMIT=200
LONG_HORIZON_FUNDING_MAX_PAGES=10
LONG_HORIZON_FUNDING_TIMEOUT=15
LONG_HORIZON_FUNDING_RETRY_AFTER=900
LONG_HORIZON_FUNDING_BATCH_SIZE=8
LONG_HORIZON_FUNDING_MAX_ATTEMPTS=8
# Leave empty to use all supported exchanges
PUMP_EXCHANGES=

# Telegram alerts (notifier service)
# Get token from @BotFather, chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notifier: alert if the scanner has not produced a fresh snapshot in this many
# seconds. Keep below the pumps:latest Redis TTL (300s).
STALE_AFTER_SECONDS=240
# Notifier pump gate: only pumps reaching this percent trigger an alert. 0 = all.
NOTIFY_MIN_PCT=60

# Execution — exchange API keys (only exchanges with both key+secret are activated)
# MEXC: Access Key → MEXC_API_KEY, Secret Key → MEXC_API_SECRET
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# Execution — testnet mode
# Set to true to route all exchanges to sandbox/testnet endpoints.
# When enabled, populate exchange key vars with testnet API keys.
TESTNET=false

# Execution — risk parameters
MAX_POSITIONS=5
MAX_POSITION_USD=500
DAILY_LOSS_LIMIT_USD=200
SCORE_THRESHOLD=6
LIQUIDATION_BUFFER_PCT=20
MIN_FUNDING_RATE_PCT=-0.1
REQUIRE_FUNDING_RATE=false
RISK_PER_TRADE_PCT=0
# Fail-closed execution-quality gate. $50 position × 2 depth requires a fillable
# $100 bid and ask book; spread and VWAP impact are capped independently.
REQUIRE_MARKET_QUALITY=true
MAX_SPREAD_BPS=50
MAX_LIQUIDITY_IMPACT_BPS=50
LIQUIDITY_DEPTH_MULTIPLIER=2
REQUIRE_RED_CANDLE=false
MIN_RETRACE_PCT=0

# Execution — exit strategy (dynamic, derived from pump magnitude — no manual config needed)

# Execution — signal trader (auto-shorting on pump signals)
# Set AUTO_TRADE=true to enable real orders. Set DRY_RUN=true for paper trading (mutually exclusive).
# DRY_RUN uses public exchange clients — no API keys needed for price feeds.
AUTO_TRADE=false
DRY_RUN=false
SIGNAL_POSITION_USD=50
SIGNAL_LEVERAGE=3
STRATEGY_VERSION=pump_short_v1_market_quality
MEASUREMENT_STRATEGY_VERSION=pump_short_measurement_v1
