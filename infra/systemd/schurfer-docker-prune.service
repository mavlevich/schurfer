[Unit]
Description=Schurfer weekly Docker build cache and dangling image prune
After=docker.service
Requires=docker.service

# Bounded (until=168h = 7 days), not a blanket -af with no filter: an active
# multi-day deploy cadence (see this same day's own disk-usage-status PR)
# still benefits from same-week layer cache reuse between back-to-back
# deploys. Only truly stale cache/images get reclaimed. Decoupled from
# `make prod-deploy` on purpose: pruning on every deploy would kill the
# cache the VERY NEXT deploy needs to stay fast, turning every deploy into
# a full rebuild.
[Service]
Type=oneshot
User=deploy
Group=deploy
# --config points the docker CLI at a private, systemd-managed scratch dir
# instead of the real ~/.docker (found broken 2026-08-17, three days after
# this unit first shipped: ProtectHome=true correctly hides /home/deploy/
# .docker from this service, but the docker CLI itself doesn't treat a
# missing/unreadable config.json as "use defaults" -- it warns "permission
# denied", then fails the whole invocation with exit 125 before ever
# running the prune, so the weekly timer had been silently doing nothing
# since it was installed. This service only ever prunes the local daemon's
# own build cache/images -- no registry auth, no pull/push -- so it never
# legitimately needed the real ~/.docker (which may hold real registry
# credentials) in the first place; RuntimeDirectory gives it an empty one
# of its own instead of loosening ProtectHome to read the real one.
RuntimeDirectory=schurfer-docker-prune
ExecStart=/usr/bin/docker --config /run/schurfer-docker-prune builder prune -af --filter until=168h
ExecStart=/usr/bin/docker --config /run/schurfer-docker-prune image prune -af --filter until=168h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
