{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schurfer.local/contracts/notification-envelope-v1.schema.json",
  "title": "Schurfer notification envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notification_id",
    "dedup_key",
    "producer",
    "kind",
    "severity",
    "created_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "notification_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "dedup_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "severity": {
      "enum": ["critical", "trade", "research", "info"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
