# Production environment — copy to .env.prod and fill in all values.
# Never commit .env.prod to git.
# chmod 600 .env.prod after filling in.

# === Domain / TLS ===
# Tailscale MagicDNS hostname (private — not publicly reachable).
# Get it with: tailscale status --json | grep DNSName
# Generate the cert with: tailscale cert <hostname>, then place the files at
# infra/caddy/certs/tailscale.crt and infra/caddy/certs/tailscale.key
TAILSCALE_HOSTNAME=your-server.tailXXXXXX.ts.net

# === PostgreSQL ===
# Strong random password — generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === API Gateway ===
# Generate bcrypt hash of your admin password:
#   go run ./apps/api-gateway/cmd/hash-password your_password
ADMIN_PASSWORD_HASH=

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=

# === Telegram alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Execution — exchange API keys ===
# Use SEPARATE keys from your local dev keys.
# Before going live: disable withdrawals + set IP whitelist to this server's IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# === Execution — risk parameters ===
MAX_POSITIONS=5
MAX_POSITION_USD=500
DAILY_LOSS_LIMIT_USD=200
SCORE_THRESHOLD=6
LIQUIDATION_BUFFER_PCT=20
MIN_FUNDING_RATE_PCT=-0.1
REQUIRE_FUNDING_RATE=false
RISK_PER_TRADE_PCT=0
REQUIRE_RED_CANDLE=false
MIN_RETRACE_PCT=0

# === Execution — signal trader ===
# Start with DRY_RUN=true until everything is verified.
# AUTO_TRADE and DRY_RUN are mutually exclusive.
AUTO_TRADE=false
DRY_RUN=true
SIGNAL_POSITION_USD=50
SIGNAL_LEVERAGE=3

# === Analytics / pump scanner ===
PUMP_MIN_PCT=30
SCAN_INTERVAL=60
PUMP_EXCHANGES=

# Notifier: alert if the scanner has not produced a fresh snapshot in this many
# seconds (silently dead scanner rots the dataset). Default ~4 missed scans.
# Keep below the pumps:latest Redis TTL (300s) so a dead scanner is caught by the
# aging timestamp before the key disappears.
STALE_AFTER_SECONDS=240

# Notifier pump gate: only pumps whose max change reaches this percent trigger a
# Telegram alert (on top of the scanner's PUMP_MIN_PCT). Keeps the channel from
# being flooded by every small pump. Set 0 to alert on everything the scanner reports.
NOTIFY_MIN_PCT=60

# === Collector ===
BYBIT_SYMBOLS=
LOG_LEVEL=info
